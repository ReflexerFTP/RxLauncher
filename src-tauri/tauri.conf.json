{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RxLauncher",
  "mainBinaryName": "RxLauncher",
  "version": "3.13.0",
  "identifier": "xyz.rxlauncher.launcher",
  "build": {
    "frontendDist": "../dist-tauri"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "RxLauncher",
        "url": "index.html",
        "width": 1400,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 680,
        "center": true,
        "resizable": true,
        "maximizable": true,
        "decorations": false,
        "visible": false,
        "backgroundColor": "#091012",
        "dragDropEnabled": true,
        "useHttpsScheme": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": ["**"],
          "requireLiteralLeadingDot": false
        }
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "RxLauncher",
    "homepage": "https://rxlauncher.xyz",
    "copyright": "RxLauncher",
    "category": "Game",
    "shortDescription": "Лаунчер Minecraft",
    "longDescription": "RxLauncher — лаунчер Minecraft с модами, сборками, друзьями и защитой аккаунтов.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/**/*"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Russian", "English"],
        "displayLanguageSelector": false
      }
    }
  }
}
