<script type="application/x-rx-script">
    let currentThemeData, loadedThemeData;
    let selectedServerFromList = false;
    $(async function () {
        // Создание директорию для игры
        RxUtils.createMissingDirectories(DOT_MC_PATH);
        global.GAME_DATA = RxConfig.read("gameDirectory", DOT_MC_PATH);

        // Начинаем запуск
        RxOptimizer.init();
        RxPlayStats.getAllStats();
        RxCollector.setupLogHijacking();
        RxCollector.writeLog("Launcher started at", Date.now());

        // Обновления и сбор статистики
        if (!IS_APP_IN_DEV) {
            RxUpdater.bindUpdate();
            await RxCollector.collectAndSendStats();
        } else {
            RxCollector.writeLog("DEVMODE: No updated and stats");
        }

        // Инициализация темы
        currentThemeData = RxConfig.read("theme");
        // Миграция: старый синий дефолт -> новый красный (выбранный вручную цвет не трогаем)
        if (currentThemeData && currentThemeData.color === "rgb(10, 115, 255)") {
            currentThemeData.color = "rgb(229, 57, 53)";
            RxConfig.write("theme", currentThemeData);
        }
        loadedThemeData = {};
        RxThemes.changeTheme(false, false);
        // Своих обоев больше нет на диске — возвращаем обои по умолчанию
        RxThemes.changeWallpaper(RxConfig.read("currentWallpaper", RxThemes.DEFAULT_WALLPAPER)) || RxThemes.changeWallpaper(RxThemes.DEFAULT_WALLPAPER);
        RxThemes.applyWallpaperAppearance();
        await RxBranding.init();
        RxCollector.writeLog("Theme initialized");

        // Инициализация менеджера Java
        RxJavaManager.init();
        RxCollector.writeLog("JavaManager initialized");

        // Настраиваем кнопку для сбора debug data
        $(document).keyup((e) => {
            if (e.originalEvent.code === "F12") {
                RxCollector.collectDebugData();
            }
        })
        if (RxConfig.read("disableAnimations", false) === true) {
            $("html").addClass("noAnimations");
        }

        if (RxConfig.read("disableCssEffects", false) === true) {
            $("html").addClass("noEffects");
        }

        if (!IS_APP_IN_DEV && RxConfig.read("disableStartupAnimation", false) !== true) {
            // Запустить загрузочную анимацию
            RxUI.startLoadScreenAnimation();
            // Показываем окно
            $("html").addClass("animate__animated animate__fadeIn animate__fast");
            RxCollector.writeLog("Started animation");
        } else {
            // Отключить все эффекты для максимально быстрого запуска
            $(".hide-on-loading").removeClass("hide-on-loading");
            $(".loading-screen").hide();
            RxCollector.writeLog("DEVMODE: No start animation");
        }

        // Брошенный мимо зоны файл не должен открываться вместо лаунчера
        $(document).on("dragover drop", (event) => event.preventDefault());

        // Скрытие модалок по Esc
        $(document).keydown(e => {
            if (e.originalEvent.key === "Escape") {
                RxModals.hideCurrentOverlay();
            }
        })

        // Ожидание для загрузки всех нод
        setTimeout(() => {
            // Переводим все ноды в DOM
            RxTranslator.translateAllNodes();
            RxTranslator.loadLanguagesList();

            // Блокировка драга картинок
            $('img').on('dragstart', function (event) {
                event.preventDefault();
            });

            // Закрытие overlay modal по клику за пределы
            $(".modal-overlay").click(function () {
                RxModals.hideCurrentOverlay();
            })
        }, 500);

        // Показываем HTML
        $("html").show();

        // Показываем главный экран до асинхронной загрузки аккаунтов и
        // версий. Иначе поздний showModal("content") может раскрыть главную
        // поверх раздела, который пользователь уже успел открыть.
        RxModals.showModal("content");

        // Загружаем список аккаунтов
        await RxAccountsManager.refreshElybyProfiles();
        RxAccountsUI.reloadAccountsManager();
        RxAccountsUI.reloadAccountSelect();

        // Загружаем список версий
        RxVersionsUI.loadVersions();

        // Отправляем ipc о готовности лаунчера
        ipcRenderer.send("launcher-ready", RxDiscordRpc.getSettings());
        RxCollector.writeLog("IPC: Launcher ready");

        // Очищаем старый кэш ассетов
        RxAssetsParsers.clearAssetsCache();

        loadSettingsUI();

        // Начинаем тестирование
        if (IS_APP_IN_TEST) {
            RxCollector.writeLog("TESTMODE: Starting tests");
            RxFlyout.setUIStartMode(true);
            await RxFlyout.changeMode("spinner");
            RxFlyout.setText("Начинается тестирование");
            RxTests.startTest();
        }
    })
</script>
