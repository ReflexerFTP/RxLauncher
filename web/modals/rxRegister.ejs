<link rel="stylesheet" href="modals/rxRegister.css"/>

<div class="modal overlay centered" id="modal-rxRegister" style="display: none;">
    <div class="flex flex-gap-8 flex-align-center">
        <button class="square transparent small" onclick="RxModals.hideModal('rxRegister')">
            <span class="material-symbols-outlined">west</span>
        </button>
        <h1>{{rxAuth.register.title}}</h1>
    </div>
    <input type="text" class="login" placeholder="{{elyby.login}}"/>
    <input type="password" class="password" placeholder="{{elyby.password}}"/>
    <input type="password" class="password-repeat" placeholder="{{rxAuth.register.repeatPassword}}"/>

    <h4 class="error" style="color: var(--error); display: none;"></h4>

    <button class="loginBtn" onclick="RxSkinsUI.register()">{{rxAuth.register.go}}</button>

    <div class="link" onclick="RxSkinsUI.goLogin()">
        <span class="material-symbols-outlined">open_in_new</span>
        <span>{{rxAuth.goLogin}}</span>
    </div>
</div>