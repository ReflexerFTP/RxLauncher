<link rel="stylesheet" href="modals/rxAccount.css"/>

<!-- Аккаунт RxLauncher: вход, смена пароля и удаление (режим — data-mode). Регистрация — на сайте -->
<div class="modal overlay centered" id="modal-rxAccount" style="display: none;" data-mode="login">
    <button type="button" class="rxa-close square transparent small" data-rx-onclick="RxModals.hideModal('rxAccount')" title="{{commons.close}}">
        <span class="material-symbols-outlined">close</span>
    </button>
    <div class="rxa-hero">
        <div class="rxa-logo">
            <img src="assets/rx-logo.svg" alt=""/>
            <span class="material-symbols-outlined" data-account-icon>login</span>
        </div>
        <h1 data-account-title></h1>
        <p data-account-hint></p>
    </div>
    <form class="rxa-form" data-account-form autocomplete="off">
        <label class="rxa-field" data-modes="login">
            <span class="material-symbols-outlined">person</span>
            <input type="text" data-field="nick" maxlength="16" spellcheck="false" placeholder="{{friends.account.nick}}"/>
        </label>
        <label class="rxa-field" data-modes="login password delete">
            <span class="material-symbols-outlined">lock</span>
            <input type="password" data-field="password" maxlength="128" placeholder="{{friends.account.passwordField}}"/>
            <button type="button" class="rxa-eye" data-account-eye tabindex="-1"><span class="material-symbols-outlined">visibility</span></button>
        </label>
        <label class="rxa-field" data-modes="password">
            <span class="material-symbols-outlined">key</span>
            <input type="password" data-field="newPassword" maxlength="128" placeholder="{{friends.account.newPassword}}"/>
        </label>
        <label class="rxa-field" data-modes="password">
            <span class="material-symbols-outlined">key</span>
            <input type="password" data-field="repeat" maxlength="128" placeholder="{{friends.account.repeat}}"/>
        </label>
        <div class="rxa-error" data-account-error hidden>
            <span class="material-symbols-outlined">error</span>
            <span data-account-error-text></span>
        </div>
        <button type="submit" class="rxa-submit">
            <span data-account-submit></span>
            <span class="material-symbols-outlined" data-account-submit-icon>arrow_forward</span>
        </button>
    </form>
    <div class="rxa-discord-wrap" data-account-discord-wrap>
        <div class="rxa-or"><span>{{friends.account.or}}</span></div>
        <button type="button" class="rxa-discord" data-account-discord>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M20.3 4.4A19.8 19.8 0 0 0 15.4 3l-.6 1.2a18.4 18.4 0 0 0-5.6 0L8.6 3a19.7 19.7 0 0 0-4.9 1.5C.6 9.1-.3 13.6.1 18.1a19.9 19.9 0 0 0 6 3l1.3-2.1c-.7-.3-1.4-.6-2-1l.5-.4a14.2 14.2 0 0 0 12.2 0l.5.4c-.6.4-1.3.7-2 1l1.3 2.1a19.8 19.8 0 0 0 6-3c.5-5.2-.8-9.7-3.6-13.7zM8.1 15.3c-1.2 0-2.2-1.1-2.2-2.4s1-2.4 2.2-2.4 2.2 1.1 2.2 2.4-1 2.4-2.2 2.4zm7.8 0c-1.2 0-2.2-1.1-2.2-2.4s1-2.4 2.2-2.4 2.2 1.1 2.2 2.4-1 2.4-2.2 2.4z"/></svg>
            <span data-discord-text>{{friends.account.discord}}</span>
            <span class="material-symbols-outlined rxa-discord-spin">progress_activity</span>
        </button>
    </div>
    <div class="rxa-foot" data-account-foot>
        <span>{{friends.account.noAccount}}</span>
        <button type="button" class="rxa-link" data-account-register>
            <span>{{friends.account.registerOnSite}}</span>
            <span class="material-symbols-outlined">open_in_new</span>
        </button>
    </div>
</div>
