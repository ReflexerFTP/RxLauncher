<link rel="stylesheet" href="modals/capes.css"/>

<!-- Плащи: свой плащ для Игрок+ — нарисовать или загрузить PNG. Видят все, кто играет через RxLauncher (RxCapesUI) -->
<div class="modal" id="modal-capes" style="display: none;">
    <div class="skin-browser-shell">
        <header class="skin-browser-header">
            <div class="skin-browser-heading">
                <div class="skin-browser-heading-icon" aria-hidden="true">
                    <span class="material-symbols-outlined">checkroom</span>
                </div>
                <div>
                    <h1>{{capes.title}}</h1>
                    <p>{{capes.subtitle}}</p>
                </div>
            </div>
            <span class="skin-model-pill cape-access-pill" data-cape-access>
                <span class="material-symbols-outlined" data-cape-access-icon>lock</span>
                <span data-cape-access-label>{{capes.plusOnly}}</span>
            </span>
        </header>

        <div class="skin-browser-content cape-content">
            <section class="skin-preview-card" aria-label="{{capes.preview}}">
                <div class="skin-preview-aurora skin-preview-aurora-one"></div>
                <div class="skin-preview-aurora skin-preview-aurora-two"></div>
                <div class="skin-preview-grid" aria-hidden="true"></div>

                <div class="skin-preview-stage" data-cape-preview-stage>
                    <canvas data-skin-viewer-canvas data-cape-viewer-canvas aria-label="{{capes.preview}}"></canvas>
                    <div class="skin-preview-unavailable" data-cape-preview-unavailable hidden>
                        <span class="material-symbols-outlined" aria-hidden="true">view_in_ar</span>
                        <strong>{{skins.previewUnavailable}}</strong>
                    </div>
                </div>

                <footer class="skin-preview-footer">
                    <div class="skin-preview-tip">
                        <span class="material-symbols-outlined" aria-hidden="true">360</span>
                        <span>{{skins.previewHint}}</span>
                    </div>
                    <button type="button" class="skin-model-pill cape-pill-button" data-cape-action="elytra" aria-pressed="false">
                        <span class="material-symbols-outlined" aria-hidden="true">paragliding</span>
                        <span data-cape-equipment-label>{{capes.showElytra}}</span>
                    </button>
                </footer>
            </section>

            <aside class="skin-browser-side">
                <section class="skin-status-card is-ready" data-cape-status aria-live="polite">
                    <span class="skin-status-icon material-symbols-outlined" data-cape-status-icon>info</span>
                    <div>
                        <strong data-cape-status-title>{{capes.title}}</strong>
                        <span data-cape-status-hint>{{capes.loading}}</span>
                    </div>
                    <button type="button" class="skin-secondary-button cape-status-button" data-cape-action="login" hidden>
                        <span class="material-symbols-outlined" aria-hidden="true">login</span>
                        <span>{{friends.login}}</span>
                    </button>
                </section>

                <section class="skin-profile-card cape-editor-card">
                    <div class="cape-toolbar" role="toolbar" aria-label="{{capes.tools}}">
                        <div class="cape-tools">
                            <button type="button" class="skin-icon-button is-active" data-cape-tool="pencil" title="{{capes.pencil}}" aria-label="{{capes.pencil}}">
                                <span class="material-symbols-outlined" aria-hidden="true">edit</span>
                            </button>
                            <button type="button" class="skin-icon-button" data-cape-tool="eraser" title="{{capes.eraser}}" aria-label="{{capes.eraser}}">
                                <span class="material-symbols-outlined" aria-hidden="true">ink_eraser</span>
                            </button>
                            <button type="button" class="skin-icon-button" data-cape-tool="fill" title="{{capes.fill}}" aria-label="{{capes.fill}}">
                                <span class="material-symbols-outlined" aria-hidden="true">format_color_fill</span>
                            </button>
                            <button type="button" class="skin-icon-button" data-cape-tool="picker" title="{{capes.picker}}" aria-label="{{capes.picker}}">
                                <span class="material-symbols-outlined" aria-hidden="true">colorize</span>
                            </button>
                        </div>
                        <div class="cape-tools">
                            <button type="button" class="skin-icon-button" data-cape-action="undo" title="{{capes.undo}}" aria-label="{{capes.undo}}" disabled>
                                <span class="material-symbols-outlined" aria-hidden="true">undo</span>
                            </button>
                            <button type="button" class="skin-icon-button" data-cape-action="redo" title="{{capes.redo}}" aria-label="{{capes.redo}}" disabled>
                                <span class="material-symbols-outlined" aria-hidden="true">redo</span>
                            </button>
                            <button type="button" class="skin-icon-button" data-cape-action="template" title="{{capes.template}}" aria-label="{{capes.template}}">
                                <span class="material-symbols-outlined" aria-hidden="true">auto_awesome</span>
                            </button>
                            <button type="button" class="skin-icon-button" data-cape-action="clear" title="{{capes.clear}}" aria-label="{{capes.clear}}">
                                <span class="material-symbols-outlined" aria-hidden="true">delete_sweep</span>
                            </button>
                        </div>
                    </div>

                    <div class="cape-colors">
                        <label class="cape-color-current" title="{{capes.color}}">
                            <input type="color" data-cape-color value="#7c5cff" aria-label="{{capes.color}}"/>
                        </label>
                        <div class="cape-palette" data-cape-palette></div>
                    </div>

                    <div class="cape-canvas-wrap" data-cape-canvas-wrap>
                        <canvas data-cape-editor tabindex="0" aria-label="{{capes.editor}}"></canvas>
                    </div>
                    <div class="cape-legend">
                        <span><i class="is-cape"></i>{{capes.legendCape}}</span>
                        <span><i class="is-elytra"></i>{{capes.legendElytra}}</span>
                        <span data-cape-size>64×32</span>
                    </div>

                    <div class="skin-profile-actions cape-file-actions">
                        <button type="button" class="skin-secondary-button" data-cape-action="upload">
                            <span class="material-symbols-outlined" aria-hidden="true">upload_file</span>
                            <span>{{capes.upload}}</span>
                        </button>
                        <button type="button" class="skin-secondary-button" data-cape-action="download">
                            <span class="material-symbols-outlined" aria-hidden="true">download</span>
                            <span>{{capes.download}}</span>
                        </button>
                        <input type="file" accept="image/png" data-cape-file hidden/>
                    </div>
                    <div class="skin-profile-actions">
                        <button type="button" class="skin-primary-button" data-cape-action="save" disabled>
                            <span class="material-symbols-outlined" aria-hidden="true">cloud_upload</span>
                            <span>{{capes.save}}</span>
                        </button>
                        <button type="button" class="skin-icon-button" data-cape-action="delete" title="{{capes.delete}}" aria-label="{{capes.delete}}" hidden>
                            <span class="material-symbols-outlined" aria-hidden="true">delete</span>
                        </button>
                    </div>
                    <p class="skin-apply-hint" data-cape-nicks>{{capes.howItWorks}}</p>
                </section>

                <label class="skin-profile-card cape-ingame-toggle">
                    <input type="checkbox" data-cape-ingame/>
                    <span>
                        <strong>{{capes.inGame}}</strong>
                        <small>{{capes.inGameHint}}</small>
                    </span>
                </label>
            </aside>
        </div>
    </div>
</div>

<script type="application/x-rx-script">
    $(function () {
        RxCapesUI.bind();
    });

    document.addEventListener("showModalEvent", (event) => {
        if (event.detail.modal === "capes") RxCapesUI.onShow();
    });

    document.addEventListener("hideModalEvent", (event) => {
        if (event.detail.modal === "capes") RxCapesUI.onHide();
    });
</script>
