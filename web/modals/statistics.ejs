<link rel="stylesheet" href="modals/statistics.css"/>

<div class="modal" id="modal-statistics" style="display: none;">
    <div class="st-shell">
        <header class="inst-header st-header">
            <div class="inst-heading-icon"><span class="material-symbols-outlined">monitoring</span></div>
            <div class="inst-heading-copy">
                <div class="st-title-row">
                    <h1>{{statistics.title}}</h1>
                    <span class="st-live" id="stats-live-pill">
                        <span class="st-live-dot"></span>
                        <span>{{statistics.live}}</span>
                    </span>
                </div>
                <span>{{statistics.subtitle}}</span>
            </div>
            <div class="st-filters">
                <div class="mods-tabs st-periods" id="stats-period-tabs">
                    <button type="button" class="mods-tab stats-period-btn active" data-period="all">{{statistics.period.all}}</button>
                    <button type="button" class="mods-tab stats-period-btn" data-period="30d">{{statistics.period.month}}</button>
                    <button type="button" class="mods-tab stats-period-btn" data-period="7d">{{statistics.period.week}}</button>
                    <button type="button" class="mods-tab stats-period-btn" data-period="today">{{statistics.period.today}}</button>
                </div>
                <label class="mods-sort st-profile">
                    <span class="material-symbols-outlined">person</span>
                    <select id="stats-nickname-filter" aria-label="{{statistics.profile}}">
                        <option value="all">{{statistics.allProfiles}}</option>
                    </select>
                </label>
            </div>
        </header>

        <div class="st-scroll">
            <div class="cat-notice st-note" id="stats-migration-note">
                <span class="material-symbols-outlined">info</span>
                <span>{{statistics.migrationNote}}</span>
            </div>

            <!-- Главные цифры -->
            <section class="st-kpis">
                <article class="st-kpi st-kpi-main">
                    <span class="st-kpi-label"><span class="material-symbols-outlined">schedule</span><span>{{statistics.playtime}}</span></span>
                    <strong data-stat-value="playtime">0</strong>
                    <small><span data-stat-value="sessions">0</span> <span>{{statistics.sessions}}</span> · <span data-stat-value="avgSession"></span></small>
                </article>
                <article class="st-kpi">
                    <span class="st-kpi-label"><span class="material-symbols-outlined">swords</span><span>{{statistics.kills}}</span></span>
                    <strong data-stat-value="kills">0</strong>
                    <small>K/D <span data-stat-value="kd">0</span></small>
                </article>
                <article class="st-kpi">
                    <span class="st-kpi-label"><span class="material-symbols-outlined">skull</span><span>{{statistics.deaths}}</span></span>
                    <strong data-stat-value="deaths">0</strong>
                    <small><span>{{statistics.localTracking}}</span></small>
                </article>
                <article class="st-kpi">
                    <span class="st-kpi-label"><span class="material-symbols-outlined">local_fire_department</span><span>{{statistics.bestStreak}}</span></span>
                    <strong data-stat-value="bestStreak">0</strong>
                    <small><span>{{statistics.withoutDeath}}</span></small>
                </article>
            </section>

            <!-- Активность и календарь -->
            <section class="st-row">
                <article class="st-card st-activity">
                    <div class="st-card-head">
                        <div>
                            <h2>{{statistics.activity}}</h2>
                            <p data-stat-value="activityHint">{{statistics.activityHint}}</p>
                        </div>
                        <strong class="st-card-total" data-stat-value="activityTotal"></strong>
                    </div>
                    <div class="st-chart" id="stats-activity-chart"></div>
                </article>

                <article class="st-card st-calendar-card">
                    <div class="st-card-head">
                        <div>
                            <h2>{{statistics.calendar}}</h2>
                            <p data-stat-value="calendarHint"></p>
                        </div>
                    </div>
                    <div class="st-calendar" id="stats-calendar"></div>
                    <div class="st-legend">
                        <span>{{statistics.less}}</span>
                        <i data-level="0"></i><i data-level="1"></i><i data-level="2"></i><i data-level="3"></i><i data-level="4"></i>
                        <span>{{statistics.more}}</span>
                    </div>
                </article>
            </section>

            <!-- Где и как играете -->
            <section class="st-rankings">
                <article class="st-card" data-ranking="servers">
                    <div class="st-card-head"><div><h2>{{statistics.topServers}}</h2><p>{{statistics.byPlaytime}}</p></div><span class="material-symbols-outlined">dns</span></div>
                    <div class="st-rank-list"></div>
                </article>
                <article class="st-card" data-ranking="worlds">
                    <div class="st-card-head"><div><h2>{{statistics.topWorlds}}</h2><p>{{statistics.byPlaytime}}</p></div><span class="material-symbols-outlined">public</span></div>
                    <div class="st-rank-list"></div>
                </article>
                <article class="st-card" data-ranking="versions">
                    <div class="st-card-head"><div><h2>{{statistics.topVersions}}</h2><p>{{statistics.byPlaytime}}</p></div><span class="material-symbols-outlined">deployed_code</span></div>
                    <div class="st-rank-list"></div>
                </article>
                <article class="st-card" data-ranking="nicknames">
                    <div class="st-card-head"><div><h2>{{statistics.topNicknames}}</h2><p>{{statistics.byPlaytime}}</p></div><span class="material-symbols-outlined">badge</span></div>
                    <div class="st-rank-list"></div>
                </article>
            </section>

            <!-- Последние сессии -->
            <section class="st-card st-sessions">
                <div class="st-card-head">
                    <div>
                        <h2>{{statistics.recentSessions}}</h2>
                        <p>{{statistics.sessionsHint}}</p>
                    </div>
                    <div class="st-pagination">
                        <button class="transparent" id="stats-session-prev" title="{{statistics.previous}}">
                            <span class="material-symbols-outlined">chevron_left</span>
                        </button>
                        <span id="stats-session-page">1 / 1</span>
                        <button class="transparent" id="stats-session-next" title="{{statistics.next}}">
                            <span class="material-symbols-outlined">chevron_right</span>
                        </button>
                    </div>
                </div>
                <div class="st-session-list" id="stats-session-list"></div>
            </section>

            <footer class="st-storage">
                <span class="material-symbols-outlined">verified_user</span>
                <div class="st-storage-copy">
                    <strong>{{statistics.storageTitle}}</strong>
                    <span id="stats-storage-path"></span>
                </div>
                <button class="transparent" id="stats-refresh-button">
                    <span class="material-symbols-outlined">refresh</span>
                    <span>{{statistics.refresh}}</span>
                </button>
                <button class="transparent" id="stats-open-folder-button">
                    <span class="material-symbols-outlined">folder_open</span>
                    <span>{{statistics.openFolder}}</span>
                </button>
                <button id="stats-export-button">
                    <span class="material-symbols-outlined">download</span>
                    <span>{{statistics.export}}</span>
                </button>
            </footer>
        </div>
    </div>
</div>
