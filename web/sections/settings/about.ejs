<link rel="stylesheet" href="sections/settings/about.css"/>

<div class="flex flex-center flex-gap-8 settings-item" id="aboutItem">
    <img src="assets/icon.png" data-launcher-avatar alt="Launcher icon" height="64"/>
    <div class="flex flex-grow flex-col flex-justify-center flex-gap-4">
        <!-- Заголовок -->
        <div class="flex flex-align-center flex-gap-8">
            <span class="name">RxLauncher</span>
        </div>

        <div class="description">
            <!-- Версия лаунчера -->
            <div class="chip" id="launcherVersion">
                <span class="ver"></span>
                <div class="microdot">
                    <div class="dot"></div>
                </div>
                <span class="inDev" style="display: none">Development</span>
                <span class="inRelease" style="display: none">Release</span>
            </div>
            <div class="microdot">
                <div class="dot"></div>
            </div>
            <!-- Название OS -->
            <h3 id="about_operatingSystem"></h3>
            <div class="microdot">
                <div class="dot"></div>
            </div>
            <!-- Имя пользователя OS -->
            <h3 id="about_username"></h3>
            <div class="microdot">
                <div class="dot"></div>
            </div>
            <!-- Архитектура ПК -->
            <h3 id="about_arch"></h3>
            <div class="microdot">
                <div class="dot"></div>
            </div>
            <!-- Название процессора -->
            <h3 id="about_cpuName"></h3>
        </div>
    </div>
</div>

<!-- Сообщество и ссылки проекта -->
<section class="about-community">
    <div class="about-community-head">
        <span class="material-symbols-outlined">diversity_3</span>
        <div>
            <strong>{{settings.about.communityTitle}}</strong>
            <span>{{settings.about.communityText}}</span>
        </div>
    </div>
    <div class="about-links">
        <button type="button" class="about-link discord" data-about-link="https://discord.gg/bpRwXsXeuj" title="discord.gg/bpRwXsXeuj">
            <span class="about-link-icon">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20.3 4.4A19.8 19.8 0 0 0 15.4 3l-.6 1.2a18.4 18.4 0 0 0-5.6 0L8.6 3a19.7 19.7 0 0 0-4.9 1.5C.6 9.1-.3 13.6.1 18.1a19.9 19.9 0 0 0 6 3l1.3-2.1c-.7-.3-1.4-.6-2-1l.5-.4a14.2 14.2 0 0 0 12.2 0l.5.4c-.6.4-1.3.7-2 1l1.3 2.1a19.8 19.8 0 0 0 6-3c.5-5.2-.8-9.7-3.6-13.7zM8.1 15.3c-1.2 0-2.2-1.1-2.2-2.4s1-2.4 2.2-2.4 2.2 1.1 2.2 2.4-1 2.4-2.2 2.4zm7.8 0c-1.2 0-2.2-1.1-2.2-2.4s1-2.4 2.2-2.4 2.2 1.1 2.2 2.4-1 2.4-2.2 2.4z"/></svg>
            </span>
            <span class="about-link-copy">
                <strong>Discord</strong>
                <small>{{settings.about.discordText}}</small>
            </span>
            <span class="material-symbols-outlined about-link-arrow">north_east</span>
        </button>
        <button type="button" class="about-link telegram" data-about-link="https://t.me/rxlauncher" title="t.me/rxlauncher">
            <span class="about-link-icon">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M21.9 4.3 18.6 19.8c-.2 1-.9 1.3-1.8.8l-4.9-3.6-2.4 2.3c-.3.3-.5.5-1 .5l.4-5 9.1-8.2c.4-.4-.1-.6-.6-.2L6.2 13.4l-4.8-1.5c-1-.3-1-1 .2-1.5l18.9-7.3c.9-.3 1.6.2 1.4 1.2z"/></svg>
            </span>
            <span class="about-link-copy">
                <strong>Telegram</strong>
                <small>{{settings.about.telegramText}}</small>
            </span>
            <span class="material-symbols-outlined about-link-arrow">north_east</span>
        </button>
        <button type="button" class="about-link github" data-about-link="https://github.com/Maksimrrrsrc/RxLauncher" title="github.com/Maksimrrrsrc/RxLauncher">
            <span class="about-link-icon">
                <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8z"/></svg>
            </span>
            <span class="about-link-copy">
                <strong>GitHub</strong>
                <small>{{settings.about.githubText}}</small>
            </span>
            <span class="material-symbols-outlined about-link-arrow">north_east</span>
        </button>
        <button type="button" class="about-link site" data-about-link="https://rxlauncher.xyz" title="rxlauncher.xyz">
            <span class="about-link-icon"><img src="assets/rx-logo.svg" alt=""/></span>
            <span class="about-link-copy">
                <strong>rxlauncher.xyz</strong>
                <small>{{settings.about.siteText}}</small>
            </span>
            <span class="material-symbols-outlined about-link-arrow">north_east</span>
        </button>
    </div>
</section>

<div class="flex flex-center flex-gap-8 settings-item clickable" onclick="RxChangelogUI.open()">
    <div class="icon">
        <span class="material-symbols-outlined">history</span>
    </div>
    <div class="flex flex-grow flex-col flex-justify-center">
        <span class="name">{{settings.about.history}}</span>
    </div>
    <span class="material-symbols-outlined about-history-arrow">chevron_right</span>
</div>

<div class="flex flex-center flex-gap-8 settings-item">
    <div class="icon">
        <span class="material-symbols-outlined">category</span>
    </div>
    <div class="flex flex-grow flex-col flex-justify-center">
        <span class="name">{{settings.about.lessDataCollection.title}}</span>
        <div class="description">{{settings.about.lessDataCollection.description}}</div>
    </div>
    <label class="switch" data-setting="lessDataCollection">
        <input type="checkbox">
        <span class="inner"></span>
    </label>
</div>

<script>
    // Задаём текста из OS
    $("#about_operatingSystem").text(os.version());
    $("#about_username").text(os.userInfo().username);
    $("#about_arch").text(os.arch());
    let cpuName = os.cpus()[0].model.trim().split("@")[0].replaceAll("Processor", "");
    $("#about_cpuName").text(cpuName);
    // Задаём версию лаунчера
    $("#launcherVersion .ver").text(LAUNCHER_VERSION);

    // Ссылки сообщества открываются в браузере
    $(document).on("click", "[data-about-link]", function () {
        openExternal($(this).attr("data-about-link"));
    });

    // DEV or RELEASE mode?
    if (IS_APP_IN_DEV) {
        $("#launcherVersion .inDev").show();
    } else {
        $("#launcherVersion .inRelease").show();
    }
</script>
